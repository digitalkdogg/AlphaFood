# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=alphafood
POSTGRES_PASSWORD=changeme
POSTGRES_DB=alphafood

# ── Backend auth ──────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-secure-random-string-here
